{
  "format_version": "1.8.0",
  "animations": {
    "animation.upgraded_omnitrix.idle": {
      "loop": true,
      "animation_length": 3,
      "bones": {
        "core": {
          "position": {
            "0.0": { "vector": [0, 0, 0] },
            "1.5": { "vector": [0, 0.1, 0], "easing": "easeInOutSine" },
            "3.0": { "vector": [0, 0, 0], "easing": "easeInOutSine" }
          }
        },
        "lights": {
          "scale": {
            "0.0": { "vector": [1, 1, 1] },
            "1.5": { "vector": [1.08, 1.08, 1.08], "easing": "easeInOutSine" },
            "3.0": { "vector": [1, 1, 1], "easing": "easeInOutSine" }
          }
        },
        "dial": {
          "rotation": {
            "0.0": { "vector": [0, 0, 0] },
            "1.5": { "vector": [0, 4, 0], "easing": "easeInOutSine" },
            "3.0": { "vector": [0, 0, 0], "easing": "easeInOutSine" }
          }
        }
      }
    },

    "animation.upgraded_omnitrix.press_button": {
      "loop": "hold_on_last_frame",
      "animation_length": 0.3,
      "override_previous_animation": true,
      "bones": {
        "button": {
          "position": {
            "0.0": { "vector": [0, 0, 0] },
            "0.1": { "vector": [0, -0.5, 0], "easing": "easeOutQuad" },
            "0.3": { "vector": [0, 0, 0], "easing": "easeOutBack" }
          }
        },
        "green_cap": {
          "scale": {
            "0.0": { "vector": [1, 1, 1] },
            "0.1": { "vector": [0.92, 0.92, 0.92], "easing": "easeOutQuad" },
            "0.3": { "vector": [1, 1, 1], "easing": "easeOutBack" }
          }
        }
      }
    },

    "animation.upgraded_omnitrix.activate": {
      "loop": "hold_on_last_frame",
      "animation_length": 0.6,
      "override_previous_animation": true,
      "bones": {
        "core": {
          "position": {
            "0.0": { "vector": [0, 0, 0] },
            "0.3": { "vector": [0, 0.6, 0], "easing": "easeOutBack" },
            "0.6": { "vector": [0, 0.3, 0], "easing": "easeInOutQuad" }
          },
          "scale": {
            "0.0": { "vector": [1, 1, 1] },
            "0.3": { "vector": [1.15, 1.15, 1.15], "easing": "easeOutBack" },
            "0.6": { "vector": [1, 1, 1], "easing": "easeInOutQuad" }
          }
        },
        "dial": {
          "rotation": {
            "0.0": { "vector": [0, 0, 0] },
            "0.6": { "vector": [0, 360, 0], "easing": "easeOutQuad" }
          }
        },
        "dial_black_rim": {
          "rotation": {
            "0.0": { "vector": [0, 0, 0] },
            "0.6": { "vector": [0, -360, 0], "easing": "easeOutQuad" }
          }
        },
        "lights": {
          "scale": {
            "0.0": { "vector": [1, 1, 1] },
            "0.35": { "vector": [1.4, 1.4, 1.4], "easing": "easeOutQuad" },
            "0.6": { "vector": [1.15, 1.15, 1.15], "easing": "easeInOutQuad" }
          }
        },
        "green_cap": {
          "position": {
            "0.0": { "vector": [0, 0, 0] },
            "0.25": { "vector": [0, 0.4, 0], "easing": "easeOutBack" },
            "0.6": { "vector": [0, 0.2, 0], "easing": "easeInOutQuad" }
          }
        },
        "cylinder": {
          "scale": {
            "0.0": { "vector": [1, 1, 1] },
            "0.3": { "vector": [1, 1.2, 1], "easing": "easeOutBack" },
            "0.6": { "vector": [1, 1, 1], "easing": "easeInOutQuad" }
          }
        }
      }
    },

    "animation.upgraded_omnitrix.transform_pulse": {
      "loop": "hold_on_last_frame",
      "animation_length": 0.4,
      "override_previous_animation": true,
      "bones": {
        "os_omnitrix": {
          "scale": {
            "0.0": { "vector": [1, 1, 1] },
            "0.15": { "vector": [1.25, 1.25, 1.25], "easing": "easeOutQuad" },
            "0.4": { "vector": [1, 1, 1], "easing": "easeOutBounce" }
          }
        },
        "lights": {
          "scale": {
            "0.0": { "vector": [1, 1, 1] },
            "0.15": { "vector": [1.6, 1.6, 1.6], "easing": "easeOutQuad" },
            "0.4": { "vector": [1, 1, 1], "easing": "easeOutBounce" }
